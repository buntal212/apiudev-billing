        "body": {
          "mode": "raw",
          "raw": "{\n  \"provider\": \"midtrans\",\n  \"payment_method\": \"va_bca\",\n  \"idempotency_key\": \"{{dynamic_chk_idemp}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/{{integration_prefix}}/invoices/{{invoice_number}}/checkout",
          "host": ["{{base_url}}"],
          "path": [
            "{{integration_prefix}}",
            "invoices",
            "{{invoice_number}}",
            "checkout"
          ]
        },
        "description": "Meminta sesi pembayaran BCA Virtual Account (Menghasilkan nomor VA BCA)."
      },
      "response": []
    },
