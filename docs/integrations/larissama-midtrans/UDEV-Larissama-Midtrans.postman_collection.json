          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set(\"dynamic_chk_idemp\", \"chk-\" + pm.environment.get(\"invoice_number\") + \"-gopay-\" + Date.now());"
            ]
