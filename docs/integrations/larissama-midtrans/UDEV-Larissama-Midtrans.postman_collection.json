          "host": ["{{base_url}}"],
          "path": [
            "{{integration_prefix}}",
            "invoices",
            "{{invoice_number}}",
            "checkout"
          ]
        },
        "description": "Meminta sesi checkout GoPay (Menghasilkan checkout_url deeplink)."
      },
      "response": []
    },
    {
      "name": "14. Cek Status Invoice (Polling / Rekonsiliasi)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/{{integration_prefix}}/invoices/{{invoice_number}}?reconcile=true",
          "host": ["{{base_url}}"],
          "path": ["{{integration_prefix}}", "invoices", "{{invoice_number}}"],
          "query": [
            {
              "key": "reconcile",
              "value": "true",
              "description": "Jika true, UDEV akan memverifikasi status langsung ke payment gateway jika masih pending."
            }
          ]
        },
        "description": "Membaca status terkini faktur penagihan, status pembayaran, dan masa aktif subscription."
      },
      "response": []
    },
    {
      "name": "15. Cek Status Subscription Resmi Pelanggan",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/{{integration_prefix}}/customers/{{customer_id}}/subscription",
          "host": ["{{base_url}}"],
          "path": [
            "{{integration_prefix}}",
            "customers",
            "{{customer_id}}",
            "subscription"
          ]
        },
        "description": "Membaca masa aktif langganan resmi warung (starts_at dan expires_at) untuk sinkronisasi lokal."
      },
      "response": []
    },
    {
      "name": "16. Riwayat Transaksi Penagihan Pelanggan",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/{{integration_prefix}}/customers/{{customer_id}}/transactions?page=1&per_page=15",
          "host": ["{{base_url}}"],
          "path": [
            "{{integration_prefix}}",
            "customers",
            "{{customer_id}}",
            "transactions"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "per_page",
              "value": "15"
            }
          ]
        },
        "description": "Mengambil histori seluruh invoice dan payment attempts warung secara terpaginasi."
      },
      "response": []
    }
  ]
